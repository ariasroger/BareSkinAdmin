@model AdminBareSkin.Models.LoginViewModel
@{
    Layout = null;
    ViewData["Title"] = "Acceso privado | Bare Skin";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>BARE SKIN | Administración privada</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600&family=Montserrat:wght@300;400;500;600&display=swap" rel="stylesheet">

    <style>
            :root {
                --gold: #c9a66b;
                --gold-light: #e5c895;
                --black: #100f0e;
                --panel: #191817;
                --muted: #92908c;
                --border: rgba(201,166,107,.22);
            }

            * {
                box-sizing: border-box;
            }

            body {
                margin: 0;
                min-height: 100vh;
                background: var(--black);
                color: #fff;
                font-family: 'Montserrat', sans-serif;
            }

            .page {
                min-height: 100vh;
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 35px;
                background: radial-gradient(ellipse at 15% 15%, rgba(164,119,62,.13), transparent 40%), radial-gradient(ellipse at 85% 90%, rgba(164,119,62,.10), transparent 40%), #100f0e;
            }

            .login-container {
                width: 100%;
                max-width: 1080px;
                min-height: 650px;
                display: grid;
                grid-template-columns: 1fr 0.9fr;
                overflow: hidden;
                border: 1px solid var(--border);
                border-radius: 12px;
                background: #171615;
                box-shadow: 0 35px 100px rgba(0,0,0,.65);
                animation: appear .8s ease both;
            }

            .visual-panel {
                position: relative;
                min-height: 650px;
                display: flex;
                flex-direction: column;
                justify-content: space-between;
                padding: 48px;
                background: linear-gradient(180deg, rgba(0,0,0,.08), rgba(0,0,0,.85)), url('https://images.unsplash.com/photo-1594035910387-fea47794261f?auto=format&fit=crop&w=1200&q=85') center / cover;
            }

                .visual-panel::after {
                    content: "";
                    position: absolute;
                    inset: 0;
                    border-right: 1px solid rgba(255,255,255,.08);
                    background: linear-gradient(90deg, transparent, rgba(0,0,0,.12));
                    pointer-events: none;
                }

            .visual-content, .visual-footer {
                position: relative;
                z-index: 1;
            }

            .brand-small {
                letter-spacing: 7px;
                font-size: 13px;
                color: var(--gold-light);
            }

            .visual-title {
                font-family: 'Cormorant Garamond', serif;
                font-size: clamp(48px, 6vw, 76px);
                font-weight: 400;
                line-height: .98;
                margin: 0 0 20px;
                color: #fff;
            }

                .visual-title span {
                    color: var(--gold-light);
                }

            .visual-description {
                max-width: 340px;
                color: rgba(255,255,255,.75);
                font-size: 12px;
                line-height: 2;
                letter-spacing: 1px;
            }

            .visual-line {
                width: 55px;
                height: 1px;
                background: var(--gold);
                margin-bottom: 22px;
            }

            .visual-footer {
                color: rgba(255,255,255,.55);
                font-size: 9px;
                letter-spacing: 3px;
            }

            .form-panel {
                display: flex;
                flex-direction: column;
                justify-content: center;
                padding: 65px 55px;
            }

            .brand {
                text-align: center;
                margin-bottom: 48px;
            }

            .brand-name {
                font-family: 'Cormorant Garamond', serif;
                font-size: 43px;
                font-weight: 500;
                letter-spacing: 10px;
                color: var(--gold-light);
            }

            .brand-subtitle {
                margin-top: 7px;
                color: #aaa29a;
                font-size: 9px;
                letter-spacing: 5px;
            }

            .access-label {
                text-align: center;
                color: var(--gold);
                font-size: 9px;
                letter-spacing: 3px;
                margin-bottom: 12px;
            }

            .form-title {
                text-align: center;
                font-family: 'Cormorant Garamond', serif;
                font-size: 34px;
                font-weight: 400;
                margin: 0 0 10px;
            }

            .form-subtitle {
                text-align: center;
                color: var(--muted);
                font-size: 11px;
                margin-bottom: 35px;
            }

            .field {
                margin-bottom: 23px;
            }

                .field label {
                    display: block;
                    color: #d7bd92;
                    font-size: 10px;
                    letter-spacing: 1.5px;
                    margin-bottom: 10px;
                }

            .input-wrap {
                position: relative;
            }

                .input-wrap input {
                    width: 100%;
                    height: 53px;
                    padding: 0 45px 0 16px;
                    border: 1px solid #393633;
                    border-radius: 5px;
                    background: #22211f;
                    color: white;
                    font-family: 'Montserrat', sans-serif;
                    font-size: 12px;
                    outline: none;
                    transition: .3s;
                }

                    .input-wrap input:focus {
                        border-color: var(--gold);
                        box-shadow: 0 0 0 3px rgba(201,166,107,.09);
                    }

                    .input-wrap input::placeholder {
                        color: #77736e;
                    }

            .toggle-password {
                position: absolute;
                right: 13px;
                top: 50%;
                transform: translateY(-50%);
                background: transparent;
                border: 0;
                color: #aaa29a;
                cursor: pointer;
                font-size: 17px;
            }

            .remember {
                display: flex;
                align-items: center;
                gap: 9px;
                color: #aaa29a;
                font-size: 10px;
                margin: 5px 0 28px;
            }

                .remember input {
                    accent-color: var(--gold);
                    width: 14px;
                    height: 14px;
                }

            .submit-btn {
                width: 100%;
                height: 54px;
                border: 1px solid var(--gold);
                border-radius: 4px;
                background: linear-gradient(110deg, #b99158, #dfc18b);
                color: #17120d;
                font-family: 'Montserrat', sans-serif;
                font-weight: 600;
                font-size: 11px;
                letter-spacing: 3px;
                cursor: pointer;
                transition: .3s;
            }

                .submit-btn:hover {
                    background: #eed5a5;
                    box-shadow: 0 8px 30px rgba(201,166,107,.2);
                    transform: translateY(-2px);
                }

            .validation {
                color: #ef8989;
                font-size: 11px;
                margin-bottom: 18px;
                text-align: center;
            }

            .footer {
                text-align: center;
                color: #69645e;
                font-size: 9px;
                letter-spacing: 2px;
                margin-top: 42px;
            }

            @@keyframes appear {
                from {
                    opacity: 0;
                    transform: translateY(18px);
                }

                to {
                    opacity: 1;
                    transform: translateY(0);
                }
            }

            @@media (max-width: 760px) {
                .page {
                    padding: 15px;
                }

                .login-container {
                    max-width: 460px;
                    min-height: auto;
                    grid-template-columns: 1fr;
                }

                .visual-panel {
                    display: none;
                }

                .form-panel {
                    padding: 48px 28px;
                }

                .brand {
                    margin-bottom: 35px;
                }

                .brand-name {
                    font-size: 38px;
                }

                .footer {
                    margin-top: 32px;
                }
            }
    </style>
</head>

<body>
    <main class="page">
        <section class="login-container">

            <div class="visual-panel">
                <div class="visual-content">
                    <div class="brand-small">BARE SKIN</div>
                </div>

                <div class="visual-content">
                    <div class="visual-line"></div>

                    <h1 class="visual-title">
                        Los sueños<br />
                        se construyen<br />
                        con <span>determinación.</span>
                    </h1>

                    <p class="visual-description">
                        CADA GRAN LOGRO COMIENZA CON UNA IDEA,
                        CRECE CON ESFUERZO Y SE HACE REALIDAD
                        CON CONSTANCIA Y PASIÓN.
                    </p>
                </div>

                <div class="visual-footer">
                    PERFUMERÍA & FRAGANCIAS · COSTA RICA
                </div>
            </div>

            <div class="form-panel">

                <div class="brand">
                    <div class="brand-name">BARE SKIN</div>
                    <div class="brand-subtitle">PERFUMERÍA & FRAGANCIAS</div>
                </div>

                <div class="access-label">PRIVATE ACCESS</div>

                <h2 class="form-title">Bienvenido de nuevo</h2>

                <p class="form-subtitle">
                    Ingresá tus credenciales para continuar
                </p>

                <form asp-controller="Account"
                      asp-action="Login"
                      method="post">

                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly"
                         class="validation"></div>

                    <div class="field">
                        <label asp-for="Email">CORREO ELECTRÓNICO</label>

                        <div class="input-wrap">
                            <input asp-for="Email"
                                   type="email"
                                   placeholder="usuario@bareskin.com"
                                   autocomplete="username" />
                        </div>

                        <span asp-validation-for="Email"
                              class="validation"></span>
                    </div>

                    <div class="field">
                        <label asp-for="Password">CONTRASEÑA</label>

                        <div class="input-wrap">
                            <input asp-for="Password"
                                   id="password"
                                   type="password"
                                   placeholder="Ingresá tu contraseña"
                                   autocomplete="current-password" />

                            <button type="button"
                                    class="toggle-password"
                                    onclick="togglePassword()"
                                    aria-label="Mostrar u ocultar contraseña">
                                ◉
                            </button>
                        </div>

                        <span asp-validation-for="Password"
                              class="validation"></span>
                    </div>

                    <label class="remember">
                        <input asp-for="RememberMe" />
                        Recordar mi sesión
                    </label>

                    <button type="submit" class="submit-btn">
                        INGRESAR
                    </button>

                </form>

                <div class="footer">
                    BARE SKIN © 2026 · SISTEMA ADMINISTRATIVO
                </div>

            </div>
        </section>
    </main>

    <script>
            function togglePassword() {
                const input = document.getElementById('password');

                input.type = input.type === 'password'
                    ? 'text'
                    : 'password';
            }
    </script>
</body>
</html>
