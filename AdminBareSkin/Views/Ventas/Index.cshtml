@model IEnumerable<AdminBareSkin.Models.Venta>

@{
    ViewData["Title"] = "Registro de ventas";

    var ventas = Model?.ToList() ?? new List<AdminBareSkin.Models.Venta>();

    var totalVentas = ventas.Count;
    var totalVendido = ventas.Sum(v => v.Total);
    var gananciaBruta = ventas.Sum(v => v.Ganancia);
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Ventas | Bare Skin</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap" rel="stylesheet">

    <style>
            * {
                box-sizing: border-box;
            }

            body {
                margin: 0;
                background: #101010;
                color: #f5f0e8;
                font-family: 'DM Sans', sans-serif;
            }

            .navbar {
                min-height: 102px;
                padding: 20px 4%;
                background: #090909;
                border-bottom: 1px solid #3b3020;
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 20px;
            }

            .brand {
                color: #d6b778;
                font-family: 'Playfair Display', serif;
                font-size: 29px;
                font-weight: 700;
                letter-spacing: 4px;
                text-decoration: none;
            }

                .brand small {
                    display: block;
                    font-family: 'DM Sans', sans-serif;
                    font-size: 9px;
                    letter-spacing: 3px;
                    color: #c5ad80;
                    margin-top: 2px;
                }

            .nav-links {
                display: flex;
                gap: 32px;
            }

                .nav-links a {
                    color: #d8c6a2;
                    text-decoration: none;
                    font-size: 12px;
                    letter-spacing: 1px;
                    transition: .2s;
                }

                    .nav-links a:hover {
                        color: #e8c783;
                    }

            .container-page {
                width: 94%;
                max-width: 1450px;
                margin: 36px auto;
            }

            .top-section {
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 20px;
                margin-bottom: 25px;
            }

            .eyebrow {
                color: #c6ad80;
                font-size: 13px;
                margin-bottom: 8px;
            }

            h1 {
                color: #e5c58b;
                font-family: 'Playfair Display', serif;
                font-size: 32px;
                font-weight: 500;
                margin: 0;
            }

            .subtitle {
                color: #bcb5aa;
                margin-top: 8px;
                font-size: 15px;
            }

            .btn-primary {
                display: inline-block;
                background: #d3b477;
                color: #15120d;
                padding: 14px 21px;
                border-radius: 8px;
                text-decoration: none;
                font-weight: 700;
                border: none;
                transition: .2s;
            }

                .btn-primary:hover {
                    background: #e6ca91;
                    color: #15120d;
                    transform: translateY(-2px);
                }

            .stats {
                display: grid;
                grid-template-columns: repeat(3, 1fr);
                gap: 16px;
                margin-bottom: 24px;
            }

            .stat-card {
                background: #191714;
                border: 1px solid #443927;
                border-radius: 13px;
                padding: 24px 22px;
            }

            .stat-label {
                color: #d0b27c;
                font-size: 13px;
                margin-bottom: 12px;
            }

            .stat-value {
                color: #e8c783;
                font-family: 'Playfair Display', serif;
                font-size: 27px;
                font-weight: 600;
            }

            .content-card {
                background: #191714;
                border: 1px solid #443927;
                border-radius: 13px;
                padding: 23px;
            }

                .content-card h2 {
                    color: #e5c58b;
                    font-family: 'Playfair Display', serif;
                    font-size: 21px;
                    font-weight: 500;
                    margin: 0 0 20px;
                }

            .table-wrapper {
                width: 100%;
                overflow-x: auto;
            }

            table {
                width: 100%;
                border-collapse: collapse;
                min-width: 850px;
            }

            thead th {
                color: #d4ad69;
                font-size: 11px;
                letter-spacing: .7px;
                text-align: left;
                padding: 14px 9px;
                border-bottom: 1px solid #51432e;
                white-space: nowrap;
            }

            tbody td {
                padding: 14px 9px;
                border-bottom: 1px solid #332d24;
                color: #eee9e1;
                font-size: 14px;
                white-space: nowrap;
            }

            tbody tr:hover {
                background: #211e19;
            }

            .sale-id {
                color: #e2bd79;
                font-weight: 700;
            }

            .money {
                color: #e6c17d;
                font-weight: 600;
            }

            .btn-delete {
                background: transparent;
                color: #e58b83;
                border: 1px solid #a95d56;
                border-radius: 6px;
                padding: 8px 12px;
                font-size: 12px;
                font-weight: 600;
                cursor: pointer;
                transition: .2s;
            }

                .btn-delete:hover {
                    background: #b85f57;
                    border-color: #b85f57;
                    color: white;
                }

            .alert {
                padding: 14px 18px;
                border-radius: 8px;
                margin-bottom: 20px;
                font-size: 14px;
            }

            .alert-success {
                background: #1d3024;
                border: 1px solid #416c4e;
                color: #b8e2c1;
            }

            .alert-danger {
                background: #351d1d;
                border: 1px solid #814444;
                color: #f0b7b7;
            }

            .empty-state {
                text-align: center;
                padding: 45px 15px;
                color: #bdb3a3;
            }

                .empty-state p {
                    margin-bottom: 20px;
                }

            .back-link {
                display: inline-block;
                color: #c9b38c;
                margin-top: 25px;
                text-decoration: underline;
            }

                .back-link:hover {
                    color: #f0d49d;
                }

            @@media (max-width: 700px) {
                .navbar {
                    padding: 18px 5%;
                    align-items: flex-start;
                    flex-direction: column;
                }

                .nav-links {
                    gap: 22px;
                }

                .container-page {
                    width: 92%;
                    margin-top: 25px;
                }

                .top-section {
                    align-items: flex-start;
                    flex-direction: column;
                }

                h1 {
                    font-size: 28px;
                }

                .btn-primary {
                    width: 100%;
                    text-align: center;
                }

                .stats {
                    grid-template-columns: 1fr;
                    gap: 12px;
                }

                .stat-card {
                    padding: 19px;
                }

                .content-card {
                    padding: 16px 12px;
                }
            }
    </style>
</head>

<body>

    <header class="navbar">
        <a asp-controller="Home" asp-action="Index" class="brand">
            BARE SKIN
            <small>PERFUMERÍA & FRAGANCIAS</small>
        </a>

        <nav class="nav-links">
            <a asp-controller="Home" asp-action="Index">DASHBOARD</a>
            <a asp-controller="Inventario" asp-action="Index">INVENTARIO</a>
        </nav>
    </header>

    <main class="container-page">

        <div class="top-section">
            <div>
                <div class="eyebrow">BARE SKIN · ADMINISTRACIÓN</div>
                <h1>Registro de ventas</h1>
                <div class="subtitle">
                    Controlá las operaciones de tu perfumería.
                </div>
            </div>

            <a asp-controller="Ventas"
               asp-action="Crear"
               class="btn-primary">
                + Registrar venta
            </a>
        </div>

        @if (TempData["Mensaje"] != null)
        {
            <div class="alert alert-success">
                @TempData["Mensaje"]
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">
                @TempData["Error"]
            </div>
        }

        <section class="stats">

            <div class="stat-card">
                <div class="stat-label">VENTAS REGISTRADAS</div>
                <div class="stat-value">@totalVentas</div>
            </div>

            <div class="stat-card">
                <div class="stat-label">TOTAL VENDIDO</div>
                <div class="stat-value">
                    ₡ @totalVendido.ToString("N0")
                </div>
            </div>

            <div class="stat-card">
                <div class="stat-label">GANANCIA BRUTA</div>
                <div class="stat-value">
                    ₡ @gananciaBruta.ToString("N0")
                </div>
            </div>

        </section>

        <section class="content-card">

            <h2>Historial de ventas</h2>

            @if (ventas.Any())
            {
                <div class="table-wrapper">
                    <table>
                        <thead>
                            <tr>
                                <th>VENTA</th>
                                <th>FECHA</th>
                                <th>CLIENTE</th>
                                <th>MÉTODO DE PAGO</th>
                                <th>PRODUCTOS</th>
                                <th>TOTAL</th>
                                <th>GANANCIA</th>
                                <th>ACCIONES</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var venta in ventas)
                            {
                                <tr>
                                    <td class="sale-id">
                                        #@venta.Id
                                    </td>

                                    <td>
                                        @venta.FechaRegistro.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                    </td>

                                    <td>
                                        @(string.IsNullOrWhiteSpace(venta.Cliente)
                                            ? "Venta directa"
                                            : venta.Cliente)
                                    </td>

                                    <td>
                                        @venta.MetodoPago
                                    </td>

                                    <td>
                                        @venta.Detalles.Sum(d => d.Cantidad)
                                    </td>

                                    <td class="money">
                                        ₡ @venta.Total.ToString("N0")
                                    </td>

                                    <td class="money">
                                        ₡ @venta.Ganancia.ToString("N0")
                                    </td>

                                    <td>
                                        <form asp-controller="Ventas"
                                              asp-action="Eliminar"
                                              asp-route-id="@venta.Id"
                                              method="post"
                                              onsubmit="return confirm('¿Estás seguro de eliminar esta venta? Se devolverán las unidades al inventario y se eliminará el registro.');">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="btn-delete">
                                                Eliminar
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="empty-state">
                    <p>Todavía no hay ventas registradas.</p>

                    <a asp-controller="Ventas"
                       asp-action="Crear"
                       class="btn-primary">
                        Registrar primera venta
                    </a>
                </div>
            }

        </section>

        <a asp-controller="Home"
           asp-action="Index"
           class="back-link">
            ← Volver al Dashboard
        </a>

    </main>

</body>
</html>
