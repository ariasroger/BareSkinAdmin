@model IEnumerable<AdminBareSkin.Models.Producto>

@{
    ViewData["Title"] = "Inventario | Bare Skin";
}

<style>
    body {
        background: #101010 !important;
        color: #f5f0e8;
    }

    .inventory-page {
        max-width: 1450px;
        margin: auto;
        padding: 35px 25px 55px;
        color: #f5f0e8;
    }

    .inventory-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 35px;
        flex-wrap: wrap;
    }

    .brand-label {
        color: #c7a878;
        letter-spacing: 4px;
        font-size: 11px;
        font-weight: 700;
    }

    .inventory-title {
        font-family: Georgia, serif;
        font-size: clamp(30px, 4vw, 43px);
        margin: 9px 0;
        color: #f6efe4;
    }

    .inventory-description {
        color: #99938a;
        font-size: 14px;
    }

    .btn-gold {
        background: linear-gradient(135deg, #ddc49c, #ad8954);
        color: #17130e;
        border: none;
        border-radius: 9px;
        padding: 12px 19px;
        font-weight: 700;
        text-decoration: none;
        transition: .25s;
        display: inline-block;
    }

        .btn-gold:hover {
            color: #17130e;
            transform: translateY(-2px);
            box-shadow: 0 8px 25px #c7a87830;
        }

    .btn-outline-gold {
        border: 1px solid #94764d;
        color: #d6bd95;
        border-radius: 9px;
        padding: 11px 17px;
        text-decoration: none;
        display: inline-block;
        transition: .2s;
    }

        .btn-outline-gold:hover {
            background: #c7a878;
            color: #17130e;
        }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 17px;
        margin-bottom: 30px;
    }

    .stat-card {
        background: linear-gradient(145deg, #202020, #171717);
        border: 1px solid #34302a;
        border-radius: 14px;
        padding: 23px;
        min-height: 125px;
    }

    .stat-label {
        color: #aaa197;
        font-size: 12px;
        letter-spacing: 1px;
        text-transform: uppercase;
    }

    .stat-value {
        color: #e0c49a;
        font-family: Georgia, serif;
        font-size: 27px;
        margin-top: 13px;
        font-weight: 600;
    }

    .inventory-panel {
        background: #191919;
        border: 1px solid #35312b;
        border-radius: 15px;
        overflow: hidden;
    }

    .panel-header {
        padding: 24px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
        flex-wrap: wrap;
        border-bottom: 1px solid #34302a;
    }

    .panel-title {
        font-family: Georgia, serif;
        font-size: 22px;
        color: #f4eadb;
        margin: 0;
    }

    .search-box {
        background: #101010;
        border: 1px solid #494137;
        color: #f5f0e8;
        border-radius: 8px;
        padding: 11px 14px;
        min-width: 240px;
        outline: none;
    }

        .search-box:focus {
            border-color: #c7a878;
            box-shadow: 0 0 0 3px #c7a87820;
        }

    .table-responsive {
        overflow-x: auto;
    }

    .inventory-table {
        width: 100%;
        border-collapse: collapse;
        min-width: 760px;
    }

        .inventory-table th {
            background: #22201d;
            color: #c9ae83;
            font-size: 11px;
            letter-spacing: 1px;
            text-transform: uppercase;
            padding: 17px 20px;
            font-weight: 600;
            white-space: nowrap;
        }

        .inventory-table td {
            padding: 18px 20px;
            border-top: 1px solid #302c27;
            color: #e6ded3;
            font-size: 13px;
            vertical-align: middle;
        }

        .inventory-table tbody tr:hover {
            background: #24211d;
        }

    .product-name {
        font-weight: 700;
        color: #f5eadb;
        font-size: 14px;
    }

    .product-id {
        color: #91877a;
        font-size: 11px;
        margin-top: 4px;
    }

    .price {
        color: #d7bd92;
        font-weight: 600;
        white-space: nowrap;
    }

    .stock-badge {
        display: inline-block;
        padding: 6px 10px;
        border-radius: 20px;
        background: #27352b;
        color: #a6d4aa;
        font-size: 11px;
        font-weight: 700;
    }

    .stock-low {
        background: #493326;
        color: #f0bc8b;
    }

    .stock-empty {
        background: #482828;
        color: #f2a0a0;
    }

    .action-link {
        color: #d8bd91;
        text-decoration: none;
        font-size: 12px;
        font-weight: 600;
    }

        .action-link:hover {
            color: white;
        }

    .delete-button {
        background: none;
        border: none;
        color: #d58d8d;
        font-size: 12px;
        padding: 0;
    }

        .delete-button:hover {
            color: #ffb2b2;
        }

    .empty-state {
        padding: 55px 20px;
        text-align: center;
        color: #aaa197;
    }

        .empty-state h3 {
            font-family: Georgia, serif;
            color: #e4d3b9;
            margin-bottom: 10px;
        }

    .panel-footer {
        padding: 17px 23px;
        color: #8e857b;
        font-size: 12px;
        border-top: 1px solid #34302a;
    }

    @@media (max-width: 900px) {
        .stats-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 550px) {
        .inventory-page {
            padding: 23px 13px 35px;
        }

        .stats-grid {
            gap: 10px;
        }

        .stat-card {
            padding: 16px;
            min-height: 105px;
        }

        .stat-value {
            font-size: 21px;
        }

        .inventory-top {
            align-items: flex-start;
        }

            .inventory-top .actions {
                width: 100%;
                display: flex;
                gap: 9px;
                flex-wrap: wrap;
            }

        .search-box {
            width: 100%;
            min-width: 0;
        }

        .panel-header {
            padding: 18px;
        }
    }
</style>

<div class="inventory-page">

    <div class="inventory-top">
        <div>
            <div class="brand-label">BARE SKIN / PERFUMERÍA</div>
            <h1 class="inventory-title">Control de inventario</h1>
            <p class="inventory-description">
                Administrá tus fragancias, existencias y rentabilidad.
            </p>
        </div>

        <div class="actions d-flex gap-2 flex-wrap">
            <a href="/Home/Index" class="btn-outline-gold">
                ← Dashboard
            </a>

            <a asp-controller="Inventario"
               asp-action="Crear"
               class="btn-gold">
                + Nuevo producto
            </a>
        </div>
    </div>

    <div class="stats-grid">

        <div class="stat-card">
            <div class="stat-label">Productos registrados</div>
            <div class="stat-value">@ViewBag.TotalProductos</div>
        </div>

        <div class="stat-card">
            <div class="stat-label">Unidades disponibles</div>
            <div class="stat-value">@ViewBag.TotalUnidades</div>
        </div>

        <div class="stat-card">
            <div class="stat-label">Valor de inventario</div>
            <div class="stat-value">
                ₡@(((decimal)ViewBag.ValorInventario).ToString("N0"))
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-label">Ganancia potencial</div>
            <div class="stat-value">
                ₡@(((decimal)ViewBag.GananciaPotencial).ToString("N0"))
            </div>
        </div>

    </div>

    <div class="inventory-panel">

        <div class="panel-header">
            <div>
                <h2 class="panel-title">Colección de fragancias</h2>
                <small class="text-secondary">
                    Productos registrados en tu negocio
                </small>
            </div>

            <form asp-controller="Inventario"
                  asp-action="Index"
                  method="get">
                <input type="text"
                       name="buscar"
                       value="@ViewBag.Buscar"
                       class="search-box"
                       placeholder="Buscar perfume..." />
            </form>
        </div>

        <div class="table-responsive">

            <table class="inventory-table">
                <thead>
                    <tr>
                        <th>Producto</th>
                        <th>Compra</th>
                        <th>Venta</th>
                        <th>Ganancia</th>
                        <th>Existencias</th>
                        <th>Acciones</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var producto in Model)
                        {
                            <tr>
                                <td>
                                    <div class="product-name">
                                        @producto.Nombre
                                    </div>
                                    <div class="product-id">
                                        Código #@producto.Id
                                    </div>
                                </td>

                                <td class="price">
                                    ₡@producto.PrecioCompra.ToString("N0")
                                </td>

                                <td class="price">
                                    ₡@producto.PrecioVenta.ToString("N0")
                                </td>

                                <td class="price">
                                    ₡@producto.GananciaPorUnidad.ToString("N0")
                                </td>

                                <td>
                                    @if (producto.Stock == 0)
                                    {
                                        <span class="stock-badge stock-empty">
                                            Agotado
                                        </span>
                                    }
                                    else if (producto.Stock <= 3)
                                    {
                                        <span class="stock-badge stock-low">
                                            @producto.Stock unidades
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="stock-badge">
                                            @producto.Stock unidades
                                        </span>
                                    }
                                </td>

                                <td>
                                    <div class="d-flex gap-3 align-items-center">
                                        <a asp-controller="Inventario"
                                           asp-action="Editar"
                                           asp-route-id="@producto.Id"
                                           class="action-link">
                                            Editar
                                        </a>

                                        <form asp-controller="Inventario"
                                              asp-action="Eliminar"
                                              asp-route-id="@producto.Id"
                                              method="post"
                                              onsubmit="return confirm('¿Deseás retirar este producto del inventario?');">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="delete-button">
                                                Retirar
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6">
                                <div class="empty-state">
                                    <h3>Tu colección está esperando</h3>
                                    <p>
                                        Todavía no hay productos registrados
                                        o no encontramos coincidencias.
                                    </p>

                                    <a asp-controller="Inventario"
                                       asp-action="Crear"
                                       class="btn-gold mt-2">
                                        Registrar primer perfume
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

        </div>

        <div class="panel-footer">
            BARE SKIN · Control administrativo de inventario
        </div>

    </div>

</div>
